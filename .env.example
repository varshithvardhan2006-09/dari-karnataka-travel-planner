# Dari - environment template. Copy to .env.local and fill in what you need.
# Every key below is OPTIONAL: with no keys at all, Dari serves itineraries
# from its deterministic offline planner instead of an AI provider.

# Primary AI provider (Groq). Model defaults to openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secondary AI provider (Google Gemini). Model defaults to gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Public base URL, used for metadata and Open Graph image resolution.
NEXT_PUBLIC_APP_URL=http://localhost:3000
